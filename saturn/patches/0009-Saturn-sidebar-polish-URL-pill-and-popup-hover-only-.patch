+GURL ActiveUrl(BrowserView* browser_view) {
+  content::WebContents* const contents =
+      browser_view ? browser_view->GetActiveWebContents() : nullptr;
+  return contents ? contents->GetVisibleURL() : GURL();
+}
+
+// "https://www.youtube.com/watch?v=..." -> "youtube.com". Non-web pages show
+// their formatted URL ("saturn://settings").
+std::u16string DisplayDomain(const GURL& url) {
+  if (url.is_empty() || url.IsAboutBlank()) {
+    return std::u16string();
+  }
+  if (url.SchemeIsHTTPOrHTTPS()) {
+    std::string host(url.host());
+    if (base::StartsWith(host, "www.")) {
+      host = host.substr(4);
+    }
+    return url_formatter::IDNToUnicode(host);
+  }
+  return url_formatter::FormatUrl(url);
+}
+
+std::u16string FullUrl(const GURL& url) {
+  if (url.is_empty() || url.IsAboutBlank()) {
+    return std::u16string();
+  }
+  return url_formatter::FormatUrl(url, url_formatter::kFormatUrlOmitNothing,
+                                  base::UnescapeRule::NONE, nullptr, nullptr,
+                                  nullptr);
+}
