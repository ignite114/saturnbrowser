+// The popup (one per browser window, reused): a frameless window with a
+// single text field, centered over the page.
+class SaturnUrlPopup : public views::WidgetObserver,
+                       public views::TextfieldController {
+ public:
+  explicit SaturnUrlPopup(BrowserView* browser_view)
+      : browser_view_(browser_view) {}
+  SaturnUrlPopup(const SaturnUrlPopup&) = delete;
+  SaturnUrlPopup& operator=(const SaturnUrlPopup&) = delete;
+  ~SaturnUrlPopup() override = default;
+
+  void Show(const std::u16string& text, bool new_tab) {
+    new_tab_ = new_tab;
+    if (!widget_) {
+      Create();
+    }
+    if (!textfield_) {
+      return;
+    }
+
+    views::View* const page = browser_view_->contents_container();
+    gfx::Rect area = page && page->GetVisible() && !page->bounds().IsEmpty()
+                         ? page->GetBoundsInScreen()
+                         : browser_view_->GetBoundsInScreen();
+    const int w = std::min(kPopupWidth, std::max(200, area.width() - 40));
+    widget_->SetBounds(gfx::Rect(area.x() + (area.width() - w) / 2,
+                                 area.y() + (area.height() - kPopupHeight) / 2,
+                                 w, kPopupHeight));
+
+    textfield_->SetText(text);
+    widget_->Show();
+    widget_->Activate();
+    textfield_->RequestFocus();
+    textfield_->SelectAll(false);
+  }
+
+  void Hide() {
+    if (widget_ && widget_->IsVisible()) {
+      widget_->Hide();
+    }
+  }
+
+  // views::WidgetObserver:
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override {
+    if (!active) {
+      Hide();
+    }
+  }
+  void OnWidgetDestroying(views::Widget* widget) override {
+    textfield_ = nullptr;
+    observation_.Reset();
+  }
+
+  // views::TextfieldController:
+  bool HandleKeyEvent(views::Textfield* sender,
+                      const ui::KeyEvent& event) override {
+    if (event.type() != ui::EventType::kKeyPressed) {
+      return false;
+    }
+    if (event.key_code() == ui::VKEY_RETURN) {
+      Submit();
+      return true;
+    }
+    if (event.key_code() == ui::VKEY_ESCAPE) {
+      Hide();
+      return true;
+    }
+    return false;
+  }
+
+ private:
+  void Create() {
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_WINDOW_FRAMELESS);
+    params.parent = browser_view_->GetWidget()->GetNativeView();
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+    params.activatable = views::Widget::InitParams::Activatable::kYes;
+    params.name = "SaturnUrlPopup";
+    widget_ = std::make_unique<views::Widget>();
+    widget_->Init(std::move(params));
+
+    auto contents = std::make_unique<SaturnUrlPopupContents>();
+    auto textfield = std::make_unique<views::Textfield>();
+    textfield->set_controller(this);
+    textfield->SetBorder(nullptr);
+    textfield->SetBackgroundColor(kPopupColor);
+    textfield->SetTextColorId(ui::kColorSysOnSurface);
+    textfield->SetPlaceholderText(u"Search or enter URL");
+    textfield->SetPlaceholderTextColorId(ui::kColorSysOnSurfaceSubtle);
+    textfield->SetFontList(saturn::SidebarFont().DeriveWithSizeDelta(2));
+    textfield->GetViewAccessibility().SetName(u"Search or enter URL");
+    textfield_ = contents->AddChildView(std::move(textfield));
+    widget_->SetContentsView(std::move(contents));
+    observation_.Observe(widget_.get());
+  }
+
+  void Submit() {
+    std::u16string text;
+    base::TrimWhitespace(textfield_->GetText(), base::TRIM_ALL, &text);
+    Hide();
+    if (text.empty()) {
+      return;
+    }
+    BrowserWindowInterface* const browser = browser_view_->browser();
+    AutocompleteMatch match;
+    AutocompleteClassifierFactory::GetForProfile(browser->GetProfile())
+        ->Classify(text, /*in_keyword_mode=*/false,
+                   /*allow_exact_keyword_match=*/false,
+                   metrics::OmniboxEventProto::OTHER, &match, nullptr);
+    if (!match.destination_url.is_valid()) {
+      return;
+    }
+    NavigateParams params(
+        browser, match.destination_url,
+        ui::PageTransitionFromInt(match.transition |
+                                  ui::PAGE_TRANSITION_FROM_ADDRESS_BAR));
+    params.disposition = new_tab_ ? WindowOpenDisposition::NEW_FOREGROUND_TAB
+                                  : WindowOpenDisposition::CURRENT_TAB;
+    Navigate(&params);
+  }
+
+  raw_ptr<BrowserView> browser_view_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<views::Textfield> textfield_ = nullptr;
+  bool new_tab_ = false;
+  base::ScopedObservation<views::Widget, views::WidgetObserver> observation_{
+      this};
+};
+
+DEFINE_UI_CLASS_PROPERTY_TYPE(SaturnUrlPopup*)
+
+namespace {
+DEFINE_OWNED_UI_CLASS_PROPERTY_KEY(SaturnUrlPopup, kSaturnUrlPopupKey)
+}  // namespace
+
+void ShowSaturnUrlPopup(BrowserView* browser_view,
+                        const std::u16string& text,
+                        bool new_tab) {
+  if (!browser_view || !browser_view->GetWidget()) {
+    return;
+  }
+  SaturnUrlPopup* popup = browser_view->GetProperty(kSaturnUrlPopupKey);
+  if (!popup) {
+    browser_view->SetProperty(kSaturnUrlPopupKey,
+                              std::make_unique<SaturnUrlPopup>(browser_view));
+    popup = browser_view->GetProperty(kSaturnUrlPopupKey);
+  }
+  popup->Show(text, new_tab);
+}
+
+SaturnUrlPill::SaturnUrlPill(BrowserView* browser_view)
+    : browser_view_(browser_view) {
+  label_ = AddChildView(std::make_unique<views::Label>());
+  label_->SetFontList(saturn::SidebarFont());
+  label_->SetAutoColorReadabilityEnabled(false);
+  label_->SetEnabledColor(SK_ColorWHITE);
+  label_->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+  label_->SetElideBehavior(gfx::ELIDE_TAIL);
+  label_->SetCanProcessEventsWithinSubtree(false);
+
+  auto copy = std::make_unique<SaturnCopyButton>(base::BindRepeating(
+      [](SaturnUrlPill* pill) {
+        if (pill->browser_view_) {
+          chrome::ExecuteCommand(pill->browser_view_->browser(), IDC_COPY_URL);
+        }
+      },
+      base::Unretained(this)));
+  copy->SetImageModel(
+      views::Button::STATE_NORMAL,
+      ui::ImageModel::FromVectorIcon(kSaturnLinkIcon, SK_ColorWHITE,
+                                     kCopyIconSize));
+  copy->SetImageHorizontalAlignment(views::ImageButton::ALIGN_CENTER);
+  copy->SetImageVerticalAlignment(views::ImageButton::ALIGN_MIDDLE);
+  copy->SetTooltipText(u"Copy link");
+  copy->GetViewAccessibility().SetName(u"Copy link");
+  copy_ = AddChildView(std::move(copy));
+}
+
+SaturnUrlPill::~SaturnUrlPill() = default;
+
+void SaturnUrlPill::Refresh() {
+  label_->SetText(DisplayDomain(ActiveUrl(browser_view_)));
+}
+
+void SaturnUrlPill::Layout(PassKey) {
+  const int copy_x = width() - kCopyRightGap - kCopySize;
+  copy_->SetBounds(copy_x, (height() - kCopySize) / 2, kCopySize, kCopySize);
+  label_->SetBounds(kTextLeft, 0, std::max(0, copy_x - kTextLeft - 4),
+                    height());
+}
+
+void SaturnUrlPill::OnPaintBackground(gfx::Canvas* canvas) {
+  cc::PaintFlags flags;
+  flags.setAntiAlias(true);
+  flags.setColor(kWhite5);
+  canvas->DrawRoundRect(GetLocalBounds(), saturn::kSidebarUrlPillRadius,
+                        flags);
+}
+
+bool SaturnUrlPill::OnMousePressed(const ui::MouseEvent& event) {
+  return event.IsOnlyLeftMouseButton();
+}
+
+void SaturnUrlPill::OnMouseReleased(const ui::MouseEvent& event) {
+  if (event.IsLeftMouseButton() && HitTestPoint(event.location())) {
+    ShowSaturnUrlPopup(browser_view_, FullUrl(ActiveUrl(browser_view_)),
+                       /*new_tab=*/false);
+  }
+}
+
+BEGIN_METADATA(SaturnUrlPill)
+END_METADATA
