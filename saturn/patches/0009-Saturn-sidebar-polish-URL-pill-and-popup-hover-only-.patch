+int VerticalTabStripRegionView::SaturnDropZoneAt(
+    const gfx::Point& point_in_screen) const {
+  TabDragHandler* const handler = saturn_drag_handler();
+  TabStripView* const strip = tab_strip_view();
+  if (!handler || !strip || handler->IsDraggingPinnedTabs() ||
+      handler->IsDraggingGroups()) {
+    return 0;
+  }
+  auto* const header =
+      views::AsViewClass<SaturnTodayHeader>(strip->saturn_today_header());
+  if (!header || !header->IsDrawn() ||
+      !GetBoundsInScreen().Contains(point_in_screen)) {
+    return 0;
+  }
+  const gfx::Rect header_bounds = header->GetBoundsInScreen();
+  if (point_in_screen.y() < header_bounds.y()) {
+    return 1;
+  }
+  if (point_in_screen.y() <
+      header_bounds.y() + header->PinnedDropZoneHeight()) {
+    return 2;
+  }
+  return 0;
+}
+
+void VerticalTabStripRegionView::SaturnSetDropZone(int zone) {
+  if (saturn_drop_zone_ == zone) {
+    return;
+  }
+  saturn_drop_zone_ = zone;
+  if (auto* const pinned = GetPinnedTabsContainer()) {
+    pinned->SetSaturnDropSlot(zone == 1);
+  }
+  if (TabStripView* const strip = tab_strip_view()) {
+    if (auto* const header = views::AsViewClass<SaturnTodayHeader>(
+            strip->saturn_today_header())) {
+      header->SetPinnedDropHint(zone == 2);
+    }
+  }
+}
+
+void VerticalTabStripRegionView::SaturnOnTabDragMoved(
+    const gfx::Point& point_in_screen) {
+  if (TabDragHandler* const handler = saturn_drag_handler()) {
+    handler->SetSaturnDragStoppedCallback(
+        base::BindRepeating(&VerticalTabStripRegionView::SaturnOnTabDragStopped,
+                            base::Unretained(this)));
+  }
+  SaturnSetDropZone(SaturnDropZoneAt(point_in_screen));
+}
+
+void VerticalTabStripRegionView::SaturnOnTabDragStopped() {
+  // Only act if the tab was let go over the zone that is highlighted.
+  int zone = 0;
+  if (saturn_drop_zone_ != 0 &&
+      SaturnDropZoneAt(display::Screen::Get()->GetCursorScreenPoint()) ==
+          saturn_drop_zone_) {
+    zone = saturn_drop_zone_;
+  }
+  SaturnSetDropZone(0);
+  tabs::TabInterface* const tab =
+      zone ? tab_strip_model()->GetActiveTab() : nullptr;
+  if (!tab) {
+    return;
+  }
+  // The drag controller is still tearing down; act once it is done.
+  base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(
+          [](tabs::TabHandle handle, int zone) {
+            tabs::TabInterface* const tab = handle.Get();
+            if (!tab || !tab->GetBrowserWindowInterface()) {
+              return;
+            }
+            TabStripModel* const model =
+                tab->GetBrowserWindowInterface()->GetTabStripModel();
+            const int index = model->GetIndexOfTab(tab);
+            if (index == TabStripModel::kNoTab) {
+              return;
+            }
+            if (zone == 1) {
+              // Favorites: pin it (it lands at the end of the grid).
+              model->SetTabPinned(index, true);
+              return;
+            }
+            // Pinned list: the page moves into the list (a bookmark in the
+            // space's Pinned folder); clicking the row reopens it.
+            content::WebContents* const contents = tab->GetContents();
+            saturn::AddToPinned(
+                BookmarkModelFactory::GetForBrowserContext(
+                    contents->GetBrowserContext()),
+                contents->GetTitle(), contents->GetLastCommittedURL());
+            model->CloseWebContentsAt(index,
+                                      TabCloseTypes::CLOSE_USER_GESTURE);
+          },
+          tab->GetHandle(), zone));
+}
