+// Saturn: one dot per space; the current space is bright. Click switches.
+class SaturnSpaceDots : public views::View,
+                        public ProfileAttributesStorage::Observer {
+  METADATA_HEADER(SaturnSpaceDots, views::View)
+
+ public:
+  explicit SaturnSpaceDots(BrowserWindowInterface* browser)
+      : browser_(browser) {
+    if (g_browser_process->profile_manager()) {
+      observation_.Observe(&g_browser_process->profile_manager()
+                                ->GetProfileAttributesStorage());
+    }
+  }
+
+  // ProfileAttributesStorage::Observer:
+  void OnProfileAdded(const base::FilePath& profile_path) override {
+    Refresh();
+  }
+  void OnProfileWasRemoved(const base::FilePath& profile_path,
+                           const std::u16string& profile_name) override {
+    Refresh();
+  }
+  void OnProfileNameChanged(const base::FilePath& profile_path,
+                            const std::u16string& old_profile_name) override {
+    Refresh();
+  }
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    const int n = std::max<int>(1, SaturnSpaces().size());
+    return gfx::Size(n * saturn::kSpaceDotPitch, saturn::kSpacesBarHeight);
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    const auto spaces = SaturnSpaces();
+    const base::FilePath current =
+        browser_->GetProfile()->GetOriginalProfile()->GetPath();
+    const int n = static_cast<int>(spaces.size());
+    const int x0 = (width() - n * saturn::kSpaceDotPitch) / 2;
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    for (int i = 0; i < n; ++i) {
+      flags.setColor(SkColorSetARGB(
+          spaces[i]->GetPath() == current ? 0xE6 : 0x4D, 0xFF, 0xFF, 0xFF));
+      canvas->DrawCircle(
+          gfx::PointF(x0 + i * saturn::kSpaceDotPitch +
+                          saturn::kSpaceDotPitch / 2.0f,
+                      height() / 2.0f),
+          saturn::kSpaceDotSize / 2.0f, flags);
+    }
+  }
+
+  bool OnMousePressed(const ui::MouseEvent& event) override { return true; }
+
+  void OnMouseReleased(const ui::MouseEvent& event) override {
+    const auto spaces = SaturnSpaces();
+    if (const int i = IndexAt(event.location(), spaces.size()); i >= 0) {
+      SaturnSwitchSpace(browser_, spaces[i]->GetPath());
+    }
+  }
+
+  std::u16string GetRenderedTooltipText(const gfx::Point& p) const override {
+    const auto spaces = SaturnSpaces();
+    const int i = IndexAt(p, spaces.size());
+    return i >= 0 ? spaces[i]->GetLocalProfileName() : std::u16string();
+  }
+
+ private:
+  int IndexAt(const gfx::Point& p, size_t count) const {
+    const int n = static_cast<int>(count);
+    const int x0 = (width() - n * saturn::kSpaceDotPitch) / 2;
+    const int i = (p.x() - x0) / saturn::kSpaceDotPitch;
+    return (p.x() >= x0 && i >= 0 && i < n) ? i : -1;
+  }
+
+  void Refresh() {
+    PreferredSizeChanged();
+    SchedulePaint();
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  base::ScopedObservation<ProfileAttributesStorage,
+                          ProfileAttributesStorage::Observer>
+      observation_{this};
+};
