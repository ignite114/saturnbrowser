+// Saturn: bottom bar - downloads, space dots, new space.
+class SaturnSpacesBar : public views::View {
+  METADATA_HEADER(SaturnSpacesBar, views::View)
+
+ public:
+  explicit SaturnSpacesBar(BrowserWindowInterface* browser) {
+    downloads_ = AddChildView(SaturnBarButton(
+        base::BindRepeating(
+            [](BrowserWindowInterface* b) { chrome::ShowDownloads(b); },
+            base::Unretained(browser)),
+        kDownloadIcon, u"Downloads"));
+    dots_ = AddChildView(std::make_unique<SaturnSpaceDots>(browser));
+    new_space_ = AddChildView(SaturnBarButton(
+        base::BindRepeating([] {
+          ProfilePicker::Show(ProfilePicker::Params::FromEntryPoint(
+              ProfilePicker::EntryPoint::kProfileMenuAddNewProfile));
+        }),
+        kAddIcon, u"New space"));
+  }
+
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(0, saturn::kSpacesBarHeight);
+  }
+
+  void Layout(PassKey) override {
+    // Pinned to the bottom of whatever height the sidebar gives us.
+    const int s = saturn::kSpacesBarHeight;
+    const int y = std::max(0, height() - s);
+    downloads_->SetBounds(0, y, s, s);
+    new_space_->SetBounds(std::max(0, width() - s), y, s, s);
+    const int dots_w = std::max(0, width() - 2 * s);
+    dots_->SetBounds(s, y, dots_w, s);
+  }
+
+  void VisibilityChanged(views::View* starting_from, bool is_visible) override {
+    dots_->SchedulePaint();
+  }
+
+ private:
+  raw_ptr<views::ImageButton> downloads_ = nullptr;
+  raw_ptr<SaturnSpaceDots> dots_ = nullptr;
+  raw_ptr<views::ImageButton> new_space_ = nullptr;
+};
