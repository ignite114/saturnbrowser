+// Saturn: one row of the Pinned list. Click opens the page (or switches to
+// the tab already showing it); right-click offers "Remove from Pinned list".
+class SaturnPinnedRow : public views::LabelButton,
+                        public views::ContextMenuController,
+                        public ui::SimpleMenuModel::Delegate {
+  METADATA_HEADER(SaturnPinnedRow, views::LabelButton)
+
+ public:
+  SaturnPinnedRow(BrowserWindowInterface* browser,
+                  const std::u16string& title,
+                  const GURL& url,
+                  const gfx::Image& favicon)
+      : views::LabelButton(base::BindRepeating(&SaturnPinnedRow::Open,
+                                               base::Unretained(this)),
+                           title),
+        browser_(browser),
+        url_(url) {
+    SetImageModel(
+        views::Button::STATE_NORMAL,
+        favicon.IsEmpty()
+            ? ui::ImageModel::FromVectorIcon(
+                  vector_icons::kGlobeIcon,
+                  SkColorSetARGB(0xB3, 0xFF, 0xFF, 0xFF), 16)
+            : ui::ImageModel::FromImage(favicon));
+    SetImageLabelSpacing(9);
+    SetBorder(views::CreateEmptyBorder(gfx::Insets::TLBR(0, 7, 0, 8)));
+    SetEnabledTextColors(SkColorSetARGB(0xE6, 0xFF, 0xFF, 0xFF));
+    label()->SetElideBehavior(gfx::ELIDE_TAIL);
+    SetTooltipText(base::UTF8ToUTF16(url.spec()));
+    set_context_menu_controller(this);
+    UpdateBackground();
+  }
+
+  // views::Button:
+  void StateChanged(ButtonState old_state) override {
+    views::LabelButton::StateChanged(old_state);
+    UpdateBackground();
+  }
+
+  // views::ContextMenuController:
+  void ShowContextMenuForViewImpl(views::View* source,
+                                  const gfx::Point& point,
+                                  ui::mojom::MenuSourceType source_type)
+      override {
+    menu_model_ = std::make_unique<ui::SimpleMenuModel>(this);
+    menu_model_->AddItem(kRemoveCommand, u"Remove from Pinned list");
+    menu_runner_ = std::make_unique<views::MenuRunner>(
+        menu_model_.get(), views::MenuRunner::CONTEXT_MENU);
+    menu_runner_->RunMenuAt(GetWidget(), nullptr,
+                            gfx::Rect(point, gfx::Size()),
+                            views::MenuAnchorPosition::kTopLeft, source_type);
+  }
+
+  // ui::SimpleMenuModel::Delegate:
+  void ExecuteCommand(int command_id, int event_flags) override {
+    if (command_id != kRemoveCommand) {
+      return;
+    }
+    // Removing rebuilds the list (and deletes this row), so do it after the
+    // menu has finished.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&SaturnRemovePinnedUrl,
+                                  browser_->GetProfile()->GetWeakPtr(), url_));
+  }
+
+ private:
+  static constexpr int kRemoveCommand = 1;
+
+  void Open() { SaturnOpenOrSwitchTo(browser_, url_); }
+
+  void UpdateBackground() {
+    const bool hot = GetState() == views::Button::STATE_HOVERED ||
+                     GetState() == views::Button::STATE_PRESSED;
+    SetBackground(views::CreateRoundedRectBackground(
+        SkColorSetARGB(hot ? 0x1A : 0x0D, 0xFF, 0xFF, 0xFF),
+        GetLayoutConstant(LayoutConstant::kVerticalTabCornerRadius)));
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  const GURL url_;
+  std::unique_ptr<ui::SimpleMenuModel> menu_model_;
+  std::unique_ptr<views::MenuRunner> menu_runner_;
+};
