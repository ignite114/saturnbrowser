+// Saturn: each space (= profile) keeps its sidebar "Pinned" list as a bookmark
+// folder named "Pinned" under "Other bookmarks". Header-only helpers shared by
+// the tab context menu and the sidebar.
+namespace saturn {
+
+inline constexpr char16_t kPinnedFolderTitle[] = u"Pinned";
+
+inline const bookmarks::BookmarkNode* FindPinnedFolder(
+    const bookmarks::BookmarkModel* model) {
+  if (!model || !model->loaded()) {
+    return nullptr;
+  }
+  for (const auto& child : model->other_node()->children()) {
+    if (child->is_folder() && child->GetTitle() == kPinnedFolderTitle) {
+      return child.get();
+    }
+  }
+  return nullptr;
+}
+
+inline const bookmarks::BookmarkNode* FindInPinned(
+    const bookmarks::BookmarkModel* model,
+    const GURL& url) {
+  const bookmarks::BookmarkNode* folder = FindPinnedFolder(model);
+  if (!folder) {
+    return nullptr;
+  }
+  for (const auto& child : folder->children()) {
+    if (child->is_url() && child->url() == url) {
+      return child.get();
+    }
+  }
+  return nullptr;
+}
+
+// Adds `url` to the Pinned list (creating the folder on first use). No-op if
+// it is already there or the model isn't loaded.
+inline void AddToPinned(bookmarks::BookmarkModel* model,
+                        const std::u16string& title,
+                        const GURL& url) {
+  if (!model || !model->loaded() || !url.is_valid() ||
+      FindInPinned(model, url)) {
+    return;
+  }
+  const bookmarks::BookmarkNode* folder = FindPinnedFolder(model);
+  if (!folder) {
+    folder = model->AddFolder(model->other_node(),
+                              model->other_node()->children().size(),
+                              kPinnedFolderTitle);
+  }
+  model->AddNewURL(folder, folder->children().size(),
+                   title.empty() ? base::UTF8ToUTF16(url.spec()) : title,
+                   url);
+}
+
+inline void RemoveFromPinned(bookmarks::BookmarkModel* model,
+                             const bookmarks::BookmarkNode* node) {
+  if (model && node) {
+    model->Remove(node, bookmarks::metrics::BookmarkEditSource::kUser,
+                  FROM_HERE);
+  }
+}
+
+}  // namespace saturn
+
+#endif  // CHROME_BROWSER_UI_TABS_SATURN_PINNED_FOLDER_H_
