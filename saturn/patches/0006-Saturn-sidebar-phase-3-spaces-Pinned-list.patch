+// Saturn: name of the current space (profile). The initial profile shows as
+// "Primary" until the user renames it.
+std::u16string SaturnSpaceName(Profile* profile) {
+  if (!g_browser_process->profile_manager()) {
+    return u"Primary";
+  }
+  const base::FilePath path = profile->GetOriginalProfile()->GetPath();
+  ProfileAttributesEntry* const entry = g_browser_process->profile_manager()
+                                            ->GetProfileAttributesStorage()
+                                            .GetProfileAttributesWithPath(path);
+  if (!entry || (entry->IsUsingDefaultName() &&
+                 path.BaseName().value() ==
+                     base::FilePath::FromASCII(chrome::kInitialProfile)
+                         .value())) {
+    return u"Primary";
+  }
+  return entry->GetLocalProfileName();
+}
+
+// Saturn: spaces are profiles (separate cookies, favorites, Pinned list).
+// Switching shows the target space's window where this one was and minimizes
+// this one.
+void SaturnSwitchSpace(BrowserWindowInterface* from,
+                       const base::FilePath& path) {
+  if (from->GetProfile()->GetOriginalProfile()->GetPath() == path) {
+    return;
+  }
+  ui::BaseWindow* const window = from->GetWindow();
+  const bool maximized = window->IsMaximized();
+  const gfx::Rect bounds = window->GetRestoredBounds();
+  profiles::SwitchToProfile(
+      path, /*always_create=*/false,
+      base::BindOnce(
+          [](gfx::Rect bounds, bool maximized,
+             BrowserWindowInterface* target) {
+            if (!target) {
+              return;
+            }
+            ui::BaseWindow* const target_window = target->GetWindow();
+            if (maximized) {
+              target_window->Maximize();
+            } else {
+              target_window->SetBounds(bounds);
+            }
+          },
+          bounds, maximized));
+  window->Minimize();
+}
+
+std::vector<ProfileAttributesEntry*> SaturnSpaces() {
+  std::vector<ProfileAttributesEntry*> spaces;
+  if (!g_browser_process->profile_manager()) {
+    return spaces;
+  }
+  for (ProfileAttributesEntry* entry : g_browser_process->profile_manager()
+                                           ->GetProfileAttributesStorage()
+                                           .GetAllProfilesAttributesSortedForDisplay()) {
+    if (!entry->IsOmitted()) {
+      spaces.push_back(entry);
+    }
+  }
+  return spaces;
+}
+
+void SaturnOpenOrSwitchTo(BrowserWindowInterface* browser, const GURL& url) {
+  TabStripModel* const model = browser->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* const contents = model->GetWebContentsAt(i);
+    if (contents->GetLastCommittedURL() == url ||
+        contents->GetVisibleURL() == url) {
+      model->ActivateTabAt(i);
+      return;
+    }
+  }
+  chrome::AddTabAt(browser, url, -1, /*foreground=*/true);
+}
+
+void SaturnRemovePinnedUrl(base::WeakPtr<Profile> profile, GURL url) {
+  if (!profile) {
+    return;
+  }
+  bookmarks::BookmarkModel* const model =
+      BookmarkModelFactory::GetForBrowserContext(profile.get());
+  saturn::RemoveFromPinned(model, saturn::FindInPinned(model, url));
+}
