+// Saturn: the space's Pinned list ("Other bookmarks/Pinned").
+class SaturnPinnedList : public views::View,
+                         public bookmarks::BaseBookmarkModelObserver {
+  METADATA_HEADER(SaturnPinnedList, views::View)
+
+ public:
+  explicit SaturnPinnedList(BrowserWindowInterface* browser)
+      : browser_(browser),
+        model_(BookmarkModelFactory::GetForBrowserContext(
+            browser->GetProfile())) {
+    if (model_) {
+      observation_.Observe(model_.get());
+      Rebuild();
+    }
+  }
+
+  // bookmarks::BaseBookmarkModelObserver:
+  void BookmarkModelChanged() override { Rebuild(); }
+  void BookmarkNodeFaviconChanged(const bookmarks::BookmarkNode* node) override {
+    if (node->parent() == saturn::FindPinnedFolder(model_)) {
+      Rebuild();
+    }
+  }
+  void BookmarkModelBeingDeleted() override {
+    observation_.Reset();
+    model_ = nullptr;
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    const int n = static_cast<int>(children().size());
+    return gfx::Size(0, n ? n * saturn::kPinnedRowHeight +
+                                (n - 1) * saturn::kPinnedRowGap
+                          : 0);
+  }
+
+  void Layout(PassKey) override {
+    int y = 0;
+    for (views::View* child : children()) {
+      child->SetBounds(0, y, width(), saturn::kPinnedRowHeight);
+      y += saturn::kPinnedRowHeight + saturn::kPinnedRowGap;
+    }
+  }
+
+ private:
+  void Rebuild() {
+    RemoveAllChildViews();
+    if (const bookmarks::BookmarkNode* folder =
+            saturn::FindPinnedFolder(model_)) {
+      for (const auto& node : folder->children()) {
+        if (node->is_url()) {
+          AddChildView(std::make_unique<SaturnPinnedRow>(
+              browser_, node->GetTitle(), node->url(),
+              model_->GetFavicon(node.get())));
+        }
+      }
+    }
+    PreferredSizeChanged();
+  }
+
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<bookmarks::BookmarkModel> model_;
+  base::ScopedObservation<bookmarks::BookmarkModel,
+                          bookmarks::BookmarkModelObserver>
+      observation_{this};
+};
+
