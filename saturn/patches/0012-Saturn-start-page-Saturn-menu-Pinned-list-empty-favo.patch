+void Store::RenameItem(const std::string& space_id,
+                       ItemKind kind,
+                       const std::string& item_id,
+                       const std::u16string& name) {
+  Space* space = MutableSpace(space_id);
+  if (!space) {
+    return;
+  }
+  std::vector<Item>& items = space->items(kind);
+  if (auto it = std::ranges::find(items, item_id, &Item::id);
+      it != items.end() && it->custom_title != name) {
+    it->custom_title = name;
+    Changed();
+  }
+}
+
+void Store::SetItemUrl(const std::string& space_id,
+                       ItemKind kind,
+                       const std::string& item_id,
+                       const GURL& url) {
+  Space* space = MutableSpace(space_id);
+  if (!space || !url.is_valid()) {
+    return;
+  }
+  std::vector<Item>& items = space->items(kind);
+  if (auto it = std::ranges::find(items, item_id, &Item::id);
+      it != items.end() && it->url != url) {
+    it->url = url;
+    Changed();
+  }
+}
+
+void Store::MoveItem(const std::string& from_space,
+                     const std::string& to_space,
+                     ItemKind kind,
+                     const std::string& item_id) {
+  Space* from = MutableSpace(from_space);
+  Space* to = MutableSpace(to_space);
+  if (!from || !to || from == to) {
+    return;
+  }
+  std::vector<Item>& items = from->items(kind);
+  auto it = std::ranges::find(items, item_id, &Item::id);
+  if (it == items.end()) {
+    return;
+  }
+  Item item = *it;
+  items.erase(it);
+  to->items(kind).push_back(std::move(item));
+  Changed();
+}
+
 base::CallbackListSubscription Store::AddObserver(
     base::RepeatingClosure callback) {
   return observers_.Add(std::move(callback));
