+
+MenuController* g_current_menu = nullptr;
+
+// Owns the menu's widgets (the menu, and the open submenu). Menus never take
+// activation: the browser window keeps its focus and its acrylic.
+class MenuController : public ui::EventObserver, public views::WidgetObserver {
+ public:
+  MenuController(views::Widget* parent, std::vector<MenuItem> items)
+      : parent_(parent), items_(std::move(items)) {
+    parent_observation_.Observe(parent_.get());
+  }
+  MenuController(const MenuController&) = delete;
+  MenuController& operator=(const MenuController&) = delete;
+  ~MenuController() override = default;
+
+  void Show(const gfx::Point& screen_point) {
+    gfx::Rect bounds(screen_point,
+                     gfx::Size(MenuWidthFor(items_), MenuHeightFor(items_)));
+    const gfx::Rect work =
+        display::Screen::Get()->GetDisplayNearestPoint(screen_point).work_area();
+    bounds.AdjustToFit(work);
+    main_ = CreateMenuWidget(0, items_, bounds, &main_contents_);
+    event_monitor_ = views::EventMonitor::CreateApplicationMonitor(
+        this, parent_->GetNativeWindow(),
+        {ui::EventType::kMousePressed, ui::EventType::kKeyPressed});
+  }
+
+  void Close() {
+    if (closing_) {
+      return;
+    }
+    closing_ = true;
+    event_monitor_.reset();
+    parent_observation_.Reset();
+    if (sub_) {
+      sub_->Hide();
+    }
+    if (main_) {
+      main_->Hide();
+    }
+    if (g_current_menu == this) {
+      g_current_menu = nullptr;
+    }
+    base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(FROM_HERE,
+                                                               this);
+  }
+
+  void OnRowHovered(int level, size_t index) {
+    if (level != 0 || closing_) {
+      return;
+    }
+    if (static_cast<int>(index) == sub_index_) {
+      return;
+    }
+    CloseSubmenu();
+    if (!items_[index].submenu.empty() && items_[index].enabled) {
+      OpenSubmenu(index);
+    }
+  }
+
+  void OnRowPressed(int level, size_t index) {
+    if (closing_) {
+      return;
+    }
+    const MenuItem* item = nullptr;
+    if (level == 0) {
+      item = &items_[index];
+      if (!item->submenu.empty()) {
+        if (sub_index_ != static_cast<int>(index)) {
+          CloseSubmenu();
+          OpenSubmenu(index);
+        }
+        return;
+      }
+    } else if (sub_index_ >= 0) {
+      item = &items_[sub_index_].submenu[index];
+    }
+    if (!item || !item->enabled) {
+      return;
+    }
+    base::RepeatingClosure callback = item->callback;
+    Close();
+    if (callback) {
+      base::SequencedTaskRunner::GetCurrentDefault()->PostTask(FROM_HERE,
+                                                               callback);
+    }
+  }
+
+  // ui::EventObserver:
+  void OnEvent(const ui::Event& event) override {
+    if (closing_) {
+      return;
+    }
+    if (event.IsKeyEvent()) {
+      if (event.AsKeyEvent()->key_code() == ui::VKEY_ESCAPE) {
+        Close();
+      }
+      return;
+    }
+    const gfx::Point cursor =
+        display::Screen::Get()->GetCursorScreenPoint();
+    if ((main_ && main_->GetWindowBoundsInScreen().Contains(cursor)) ||
+        (sub_ && sub_->GetWindowBoundsInScreen().Contains(cursor))) {
+      return;
+    }
+    Close();
+  }
+
+  // views::WidgetObserver (the browser window):
+  void OnWidgetActivationChanged(views::Widget* widget, bool active) override {
+    if (!active) {
+      Close();
+    }
+  }
+  void OnWidgetDestroying(views::Widget* widget) override { Close(); }
+
+ private:
+  std::unique_ptr<views::Widget> CreateMenuWidget(
+      int level,
+      const std::vector<MenuItem>& items,
+      const gfx::Rect& bounds,
+      raw_ptr<MenuContents>* contents_out) {
+    views::Widget::InitParams params(
+        views::Widget::InitParams::CLIENT_OWNS_WIDGET,
+        views::Widget::InitParams::TYPE_POPUP);
+    params.parent = parent_->GetNativeView();
+    params.opacity = views::Widget::InitParams::WindowOpacity::kTranslucent;
+    params.shadow_type = views::Widget::InitParams::ShadowType::kNone;
+    params.activatable = views::Widget::InitParams::Activatable::kNo;
+    params.z_order = ui::ZOrderLevel::kFloatingUIElement;
+    params.bounds = bounds;
+    params.name = "SaturnMenu";
+    auto widget = std::make_unique<views::Widget>();
+    widget->Init(std::move(params));
+    auto contents = std::make_unique<MenuContents>(this, level, items);
+    *contents_out = contents.get();
+    widget->SetContentsView(std::move(contents));
+    (*contents_out)->set_paint_fill(!ApplyBackdrop(widget.get()));
+    widget->ShowInactive();
+    return widget;
+  }
+
+  void OpenSubmenu(size_t index) {
+    MenuRow* const row = main_contents_ ? main_contents_->RowAt(index) : nullptr;
+    if (!row) {
+      return;
+    }
+    const std::vector<MenuItem>& items = items_[index].submenu;
+    const gfx::Rect main_bounds = main_->GetWindowBoundsInScreen();
+    const gfx::Rect row_bounds = row->GetBoundsInScreen();
+    gfx::Rect bounds(main_bounds.right() + kSubmenuGap,
+                     row_bounds.y() - kPadding, MenuWidthFor(items),
+                     MenuHeightFor(items));
+    const gfx::Rect work = display::Screen::Get()
+                               ->GetDisplayNearestPoint(row_bounds.origin())
+                               .work_area();
+    if (bounds.right() > work.right()) {
+      bounds.set_x(main_bounds.x() - kSubmenuGap - bounds.width());
+    }
+    bounds.AdjustToFit(work);
+    sub_index_ = static_cast<int>(index);
+    row->SetHighlighted(true);
+    sub_ = CreateMenuWidget(1, items, bounds, &sub_contents_);
+  }
+
+  void CloseSubmenu() {
+    if (sub_index_ >= 0 && main_contents_) {
+      if (MenuRow* row = main_contents_->RowAt(sub_index_)) {
+        row->SetHighlighted(false);
+      }
+    }
+    sub_index_ = -1;
+    sub_contents_ = nullptr;
+    if (sub_) {
+      // Not from inside one of its own event handlers: hide now, delete later.
+      sub_->Hide();
+      base::SequencedTaskRunner::GetCurrentDefault()->DeleteSoon(
+          FROM_HERE, std::move(sub_));
+    }
+  }
+
+  raw_ptr<views::Widget> parent_;
+  const std::vector<MenuItem> items_;
+  std::unique_ptr<views::Widget> main_;
+  raw_ptr<MenuContents> main_contents_ = nullptr;
+  std::unique_ptr<views::Widget> sub_;
+  raw_ptr<MenuContents> sub_contents_ = nullptr;
+  int sub_index_ = -1;
+  bool closing_ = false;
+  std::unique_ptr<views::EventMonitor> event_monitor_;
+  base::ScopedObservation<views::Widget, views::WidgetObserver>
+      parent_observation_{this};
+};
+
+MenuRow::MenuRow(MenuController* controller,
+                 int level,
+                 size_t index,
+                 const MenuItem& item)
+    : views::Button(base::BindRepeating(&MenuController::OnRowPressed,
+                                        base::Unretained(controller), level,
+                                        index)),
+      controller_(controller),
+      level_(level),
+      index_(index),
+      item_(item) {
+  SetEnabled(item.enabled);
+  SetInstallFocusRingOnFocus(false);
+  GetViewAccessibility().SetName(item.label);
+}
+
+void MenuRow::OnMouseEntered(const ui::MouseEvent& event) {
+  views::Button::OnMouseEntered(event);
+  controller_->OnRowHovered(level_, index_);
+}
+
+}  // namespace
+
+void ShowMenu(views::Widget* parent,
+              const gfx::Point& screen_point,
+              std::vector<MenuItem> items) {
+  if (g_current_menu) {
+    g_current_menu->Close();
+  }
+  if (!parent || items.empty()) {
+    return;
+  }
+  g_current_menu = new MenuController(parent, std::move(items));
+  g_current_menu->Show(screen_point);
+}
+
+}  // namespace saturn
