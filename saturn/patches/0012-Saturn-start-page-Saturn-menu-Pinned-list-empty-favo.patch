+#include "third_party/skia/include/core/SkColor.h"
+
+namespace {
+
+std::optional<std::string_view> StaticFile(const std::string& path) {
+  if (path.empty() || path == "start.html") {
+    return saturn_start::kHtml;
+  }
+  if (path == "start.css") {
+    return saturn_start::kCss;
+  }
+  if (path == "start.js") {
+    return saturn_start::kJs;
+  }
+  if (path == "search.svg") {
+    return saturn_start::kSearchSvg;
+  }
+  return std::nullopt;
+}
+
+bool IsFont(const std::string& path) {
+  return path == "Inter-Regular.ttf" || path == "Inter-Medium.ttf" ||
+         path == "Inter-SemiBold.ttf";
+}
+
+bool ShouldHandle(const std::string& path) {
+  return StaticFile(path).has_value() || IsFont(path);
+}
+
+void Handle(const std::string& path,
+            content::WebUIDataSource::GotDataCallback callback) {
+  if (std::optional<std::string_view> file = StaticFile(path)) {
+    std::move(callback).Run(
+        base::MakeRefCounted<base::RefCountedString>(std::string(*file)));
+    return;
+  }
+  // The fonts ship next to the browser (see gfx::InitializeFonts()).
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+      base::BindOnce(
+          [](std::string name) {
+            std::string data;
+            base::FilePath dir;
+            if (base::PathService::Get(base::DIR_MODULE, &dir)) {
+              base::ReadFileToString(
+                  dir.AppendASCII("saturn_fonts").AppendASCII(name), &data);
+            }
+            return data;
+          },
+          path),
+      base::BindOnce(
+          [](content::WebUIDataSource::GotDataCallback callback,
+             std::string data) {
+            std::move(callback).Run(
+                base::MakeRefCounted<base::RefCountedString>(std::move(data)));
+          },
+          std::move(callback)));
+}
+
+// "search": opens what was typed (a URL, or a search) in a new tab of the
+// window's space, then closes the start page.
+class SaturnStartHandler : public content::WebUIMessageHandler {
+ public:
+  SaturnStartHandler() = default;
+  SaturnStartHandler(const SaturnStartHandler&) = delete;
+  SaturnStartHandler& operator=(const SaturnStartHandler&) = delete;
+  ~SaturnStartHandler() override = default;
+
+  // content::WebUIMessageHandler:
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "search", base::BindRepeating(&SaturnStartHandler::HandleSearch,
+                                      base::Unretained(this)));
+  }
+
+ private:
+  void HandleSearch(const base::ListValue& args) {
+    if (args.empty() || !args[0].is_string()) {
+      return;
+    }
+    std::u16string text;
+    base::TrimWhitespace(base::UTF8ToUTF16(args[0].GetString()),
+                         base::TRIM_ALL, &text);
+    content::WebContents* const contents = web_ui()->GetWebContents();
+    tabs::TabInterface* const tab =
+        tabs::TabInterface::MaybeGetFromContents(contents);
+    BrowserWindowInterface* const browser =
+        tab ? tab->GetBrowserWindowInterface() : nullptr;
+    if (text.empty() || !browser) {
+      return;
+    }
+    AutocompleteMatch match;
+    AutocompleteClassifierFactory::GetForProfile(
+        Profile::FromWebUI(web_ui()))
+        ->Classify(text, /*in_keyword_mode=*/false,
+                   /*allow_exact_keyword_match=*/false,
+                   metrics::OmniboxEventProto::OTHER, &match, nullptr);
+    if (!match.destination_url.is_valid()) {
+      return;
+    }
+    // A new tab, so it gets the space's storage partition (WebUI pages always
+    // use the default one).
+    NavigateParams params(
+        browser, match.destination_url,
+        ui::PageTransitionFromInt(match.transition |
+                                  ui::PAGE_TRANSITION_FROM_ADDRESS_BAR));
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&params);
+    // Not from inside this page's own message.
+    base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<content::WebContents> contents,
+               base::WeakPtr<BrowserWindowInterface> browser) {
+              if (!contents || !browser) {
+                return;
+              }
+              TabStripModel* const model = browser->GetTabStripModel();
+              const int index = model->GetIndexOfWebContents(contents.get());
+              if (index != TabStripModel::kNoTab && model->count() > 1) {
+                model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_NONE);
+              }
+            },
+            contents->GetWeakPtr(), browser->GetWeakPtr()));
+  }
+};
+
+}  // namespace
+
+SaturnStartUI::SaturnStartUI(content::WebUI* web_ui)
+    : content::WebUIController(web_ui) {
+  content::WebUIDataSource* const source =
+      content::WebUIDataSource::CreateAndAdd(Profile::FromWebUI(web_ui),
+                                             kSaturnStartHost);
+  source->SetRequestFilter(base::BindRepeating(&ShouldHandle),
+                           base::BindRepeating(&Handle));
+  web_ui->AddMessageHandler(std::make_unique<SaturnStartHandler>());
+  // See-through: the window's acrylic shows behind the page's 50% black.
+  web_ui->GetWebContents()->SetPageBaseBackgroundColor(SK_ColorTRANSPARENT);
+}
+
+SaturnStartUI::~SaturnStartUI() {
+  web_ui()->GetWebContents()->SetPageBaseBackgroundColor(std::nullopt);
+}
