+class MenuRow : public views::Button {
+  METADATA_HEADER(MenuRow, views::Button)
+
+ public:
+  MenuRow(MenuController* controller, int level, size_t index,
+          const MenuItem& item);
+
+  void SetHighlighted(bool highlighted) {
+    if (highlighted_ != highlighted) {
+      highlighted_ = highlighted;
+      SchedulePaint();
+    }
+  }
+
+  // views::Button:
+  void OnMouseEntered(const ui::MouseEvent& event) override;
+
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    const bool hot = GetState() == STATE_HOVERED ||
+                     GetState() == STATE_PRESSED || highlighted_;
+    if (!hot || !GetEnabled()) {
+      return;
+    }
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    flags.setColor(kRowHover);
+    canvas->DrawRoundRect(GetLocalBounds(), kRowRadius, flags);
+  }
+
+  void PaintButtonContents(gfx::Canvas* canvas) override {
+    const U8CPU alpha = GetEnabled() ? 0xFF : kDisabledAlpha;
+    if (item_.icon) {
+      canvas->DrawImageInt(
+          gfx::CreateVectorIcon(*item_.icon, kIconSize,
+                                SkColorSetA(item_.icon_color, alpha)),
+          kIconLeft, (height() - kIconSize) / 2);
+    }
+    int right = width() - kTextRightGap;
+    if (!item_.submenu.empty()) {
+      const int x = width() - kArrowRight - kArrowSize;
+      canvas->DrawImageInt(
+          gfx::CreateVectorIcon(kSaturnMenuDroprightIcon, kArrowSize,
+                                SkColorSetA(SK_ColorWHITE, alpha)),
+          x, (height() - kArrowSize) / 2);
+      right = x;
+    }
+    canvas->DrawStringRectWithFlags(
+        item_.label, SidebarFont(), SkColorSetA(SK_ColorWHITE, alpha),
+        gfx::Rect(kTextLeft, 0, std::max(0, right - kTextLeft), height()),
+        gfx::Canvas::NO_SUBPIXEL_RENDERING);
+  }
+
+ private:
+  raw_ptr<MenuController> controller_;
+  const int level_;
+  const size_t index_;
+  const MenuItem item_;
+  bool highlighted_ = false;
+};
