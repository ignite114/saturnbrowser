+// One row of a Saturn menu (Figma: the Pinned list menu). Rows without an
+// icon keep the text where it would be with one.
+struct MenuItem {
+  MenuItem();
+  MenuItem(const MenuItem&);
+  MenuItem& operator=(const MenuItem&);
+  ~MenuItem();
+
+  static MenuItem Divider();
+
+  bool divider = false;
+  raw_ptr<const gfx::VectorIcon> icon = nullptr;
+  SkColor icon_color = SK_ColorWHITE;
+  std::u16string label;
+  // Disabled rows are drawn at 30% and do nothing.
+  bool enabled = true;
+  // Runs after the menu has closed.
+  base::RepeatingClosure callback;
+  // Non-empty: the row opens this menu to its right (and has no callback).
+  std::vector<MenuItem> submenu;
+};
