+  SaturnStartUIConfig()
+      : DefaultWebUIConfig(content::kChromeUIScheme, kSaturnStartHost) {}
+};
+
+// Saturn: the start page (saturn://start). Shown at launch, for new tabs and
+// when the last tab closes: a see-through page with a search box over an
+// animated dot-art planet. The page itself lives in saturn_start_page.h.
+class SaturnStartUI : public content::WebUIController {
+ public:
+  explicit SaturnStartUI(content::WebUI* web_ui);
+  SaturnStartUI(const SaturnStartUI&) = delete;
+  SaturnStartUI& operator=(const SaturnStartUI&) = delete;
+  ~SaturnStartUI() override;
+};
