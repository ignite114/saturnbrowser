+class MenuContents : public views::View {
+  METADATA_HEADER(MenuContents, views::View)
+
+ public:
+  MenuContents(MenuController* controller,
+               int level,
+               const std::vector<MenuItem>& items)
+      : items_(items) {
+    for (size_t i = 0; i < items.size(); ++i) {
+      if (items[i].divider) {
+        AddChildView(std::make_unique<views::View>());
+      } else {
+        AddChildView(
+            std::make_unique<MenuRow>(controller, level, i, items[i]));
+      }
+    }
+  }
+
+  void set_paint_fill(bool paint_fill) { paint_fill_ = paint_fill; }
+
+  MenuRow* RowAt(size_t index) {
+    return index < children().size()
+               ? views::AsViewClass<MenuRow>(children()[index])
+               : nullptr;
+  }
+
+  // views::View:
+  void Layout(PassKey) override {
+    int y = kPadding;
+    const int w = width() - 2 * kPadding;
+    for (size_t i = 0; i < children().size(); ++i) {
+      if (i) {
+        y += kGap;
+      }
+      if (items_[i].divider) {
+        children()[i]->SetBounds(kPadding + (w - kDividerWidth) / 2, y,
+                                 kDividerWidth, 1);
+        y += 1;
+      } else {
+        children()[i]->SetBounds(kPadding, y, w, kRowHeight);
+        y += kRowHeight;
+      }
+    }
+  }
+
+  void OnPaintBackground(gfx::Canvas* canvas) override {
+    cc::PaintFlags flags;
+    flags.setAntiAlias(true);
+    gfx::RectF r(GetLocalBounds());
+    if (paint_fill_) {
+      flags.setColor(kMenuFill);
+      canvas->DrawRoundRect(r, kMenuRadius, flags);
+    }
+    flags.setStyle(cc::PaintFlags::kStroke_Style);
+    flags.setStrokeWidth(1);
+    flags.setColor(kMenuBorder);
+    r.Inset(0.5f);
+    canvas->DrawRoundRect(r, kMenuRadius - 0.5f, flags);
+  }
+
+  void OnPaint(gfx::Canvas* canvas) override {
+    views::View::OnPaint(canvas);
+    cc::PaintFlags flags;
+    flags.setColor(kDividerColor);
+    for (size_t i = 0; i < children().size(); ++i) {
+      if (items_[i].divider) {
+        canvas->DrawRect(gfx::RectF(children()[i]->bounds()), flags);
+      }
+    }
+  }
+
+ private:
+  const std::vector<MenuItem> items_;
+  bool paint_fill_ = true;
+};
