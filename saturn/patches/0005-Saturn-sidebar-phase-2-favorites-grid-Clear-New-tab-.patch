+// Saturn: closes today's (unpinned) tabs. When there are no favorites a fresh
+// New Tab is opened first so the window stays open.
+void SaturnClearTodayTabs(BrowserWindowInterface* browser) {
+  TabStripModel* const model = browser->GetTabStripModel();
+  std::vector<content::WebContents*> to_close;
+  for (int i = model->IndexOfFirstNonPinnedTab(); i < model->count(); ++i) {
+    to_close.push_back(model->GetWebContentsAt(i));
+  }
+  if (to_close.empty()) {
+    return;
+  }
+  if (model->IndexOfFirstNonPinnedTab() == 0) {
+    chrome::NewTab(browser, NewTabTypes::kNewTabButton);
+  }
+  for (content::WebContents* contents : to_close) {
+    const int index = model->GetIndexOfWebContents(contents);
+    if (index != TabStripModel::kNoTab) {
+      model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+    }
+  }
+}
+
+// Saturn: the row above today's tabs: a divider with "Clear" on the right,
+// then a "New tab" row (shown while the sidebar is expanded).
+class SaturnTodayHeader : public views::View {
+  METADATA_HEADER(SaturnTodayHeader, views::View)
+
+ public:
+  explicit SaturnTodayHeader(BrowserWindowInterface* browser) {
+    const SkColor muted = SkColorSetARGB(0x80, 0xFF, 0xFF, 0xFF);
+
+    divider_ = AddChildView(std::make_unique<views::View>());
+    divider_->SetBackground(
+        views::CreateSolidBackground(SkColorSetARGB(0x1A, 0xFF, 0xFF, 0xFF)));
+
+    auto clear = std::make_unique<views::LabelButton>(
+        base::BindRepeating(&SaturnClearTodayTabs, base::Unretained(browser)),
+        u"Clear");
+    clear->SetImageModel(
+        views::Button::STATE_NORMAL,
+        ui::ImageModel::FromVectorIcon(kArrowDownwardIcon, muted, 14));
+    clear->SetEnabledTextColors(muted);
+    clear->SetImageLabelSpacing(3);
+    clear->SetBorder(nullptr);
+    clear->SetHorizontalAlignment(gfx::ALIGN_RIGHT);
+    clear->SetTooltipText(u"Close today's tabs");
+    clear_ = AddChildView(std::move(clear));
+
+    auto new_tab = std::make_unique<shared::NewTabButton>(
+        browser, saturn::kTodayNewTabHeight,
+        GetLayoutConstant(LayoutConstant::kVerticalTabStripButtonIconSize));
+    new_tab->SetShouldShowLabel(true);
+    new_tab->SetPaintTransparent(true);
+    new_tab_ = AddChildView(std::move(new_tab));
+    new_tab_->layer()->SetOpacity(0.4f);
+  }
+
+  // views::View:
+  gfx::Size CalculatePreferredSize(
+      const views::SizeBounds& available_size) const override {
+    return gfx::Size(0, saturn::kTodayHeaderHeight);
+  }
+
+  void Layout(PassKey) override {
+    const int w = width();
+    const int row = saturn::kTodayDividerRowHeight;
+    clear_->SetBounds(std::max(0, w - saturn::kTodayClearWidth), 0,
+                      std::min(w, saturn::kTodayClearWidth), row);
+    divider_->SetBounds(
+        0, row / 2, std::max(0, w - saturn::kTodayClearWidth - 14), 1);
+    new_tab_->SetBounds(0, row + saturn::kTodayNewTabTopGap, w,
+                        saturn::kTodayNewTabHeight);
+  }
+
+ private:
+  raw_ptr<views::View> divider_ = nullptr;
+  raw_ptr<views::LabelButton> clear_ = nullptr;
+  raw_ptr<shared::NewTabButton> new_tab_ = nullptr;
+};
