+void SaturnShowTabMenu(BrowserWindowInterface* browser,
+                       tabs::TabInterface* tab,
+                       const gfx::Point& point) {
+  BrowserView* const browser_view =
+      BrowserView::GetBrowserViewForBrowser(browser);
+  if (!browser_view || !tab) {
+    return;
+  }
+  content::WebContents* const contents = tab->GetContents();
+  using Action = void (*)(BrowserWindowInterface*, tabs::TabInterface*);
+  auto bind = [&](Action fn) {
+    return base::BindRepeating(
+        [](base::WeakPtr<BrowserWindowInterface> browser,
+           tabs::TabHandle handle, Action fn) {
+          tabs::TabInterface* const tab = handle.Get();
+          if (browser && tab) {
+            fn(browser.get(), tab);
+          }
+        },
+        browser->GetWeakPtr(), tab->GetHandle(), fn);
+  };
+  // Pins the tab to the space's Pinned list or favorites (it stays open).
+  using KindAction = void (*)(BrowserWindowInterface*, tabs::TabInterface*,
+                              saturn::ItemKind);
+  static constexpr KindAction pin = [](BrowserWindowInterface* browser,
+                                       tabs::TabInterface* tab,
+                                       saturn::ItemKind kind) {
+    saturn::Store& store = saturn::Store::Get();
+    content::WebContents* const contents = tab->GetContents();
+    std::string space = saturn::GetTabSpace(contents);
+    if (space.empty()) {
+      space = store.SpaceForWindow(browser);
+    }
+    std::u16string title = saturn::GetTabCustomTitle(contents);
+    const std::string id = store.AddItem(
+        space, kind, contents->GetLastCommittedURL(),
+        title.empty() ? contents->GetTitle() : title);
+    if (!id.empty()) {
+      if (!title.empty()) {
+        store.RenameItem(space, kind, id, title);
+      }
+      saturn::SetTabTag(contents, space, kind, id);
+    }
+  };
+
+  std::vector<saturn::MenuItem> items;
+  items.push_back(SaturnMenuRow(
+      &kSaturnMenuCopyLinkIcon, u"Copy Link",
+      bind([](BrowserWindowInterface*, tabs::TabInterface* tab) {
+        SaturnCopyUrl(tab->GetContents()->GetLastCommittedURL());
+      })));
+  items.push_back(SaturnMenuRow(
+      &kSaturnMenuRenameTabIcon, u"Rename Tab",
+      bind([](BrowserWindowInterface* browser, tabs::TabInterface* tab) {
+        content::WebContents* const contents = tab->GetContents();
+        std::u16string current = saturn::GetTabCustomTitle(contents);
+        if (current.empty()) {
+          current = contents->GetTitle();
+        }
+        ShowSaturnTextPrompt(
+            BrowserView::GetBrowserViewForBrowser(browser), u"Tab name",
+            current,
+            base::BindOnce(
+                [](tabs::TabHandle handle, const std::u16string& name) {
+                  if (tabs::TabInterface* tab = handle.Get()) {
+                    saturn::SetTabCustomTitle(tab->GetContents(), name);
+                  }
+                },
+                tab->GetHandle()));
+      })));
+  items.push_back(SaturnMuteRow(
+      contents, bind([](BrowserWindowInterface*, tabs::TabInterface* tab) {
+        SaturnToggleMute(tab->GetContents());
+      })));
+  items.push_back(SaturnMenuRow(
+      &kSaturnTbPinIcon, u"Pin tab",
+      bind([](BrowserWindowInterface* browser, tabs::TabInterface* tab) {
+        pin(browser, tab, saturn::ItemKind::kPinned);
+      })));
+  items.push_back(SaturnMenuRow(
+      &kSaturnTbStarIcon, u"Pin to favourites",
+      bind([](BrowserWindowInterface* browser, tabs::TabInterface* tab) {
+        pin(browser, tab, saturn::ItemKind::kFavorite);
+      })));
+  items.push_back(saturn::MenuItem::Divider());
+  items.push_back(SaturnMenuRow(
+      &kSaturnMenuDuplicateIcon, u"Duplicate",
+      bind([](BrowserWindowInterface* browser, tabs::TabInterface* tab) {
+        const int index =
+            browser->GetTabStripModel()->GetIndexOfTab(tab);
+        if (index != TabStripModel::kNoTab &&
+            chrome::CanDuplicateTabAt(browser, index)) {
+          chrome::DuplicateTabAt(browser, index);
+        }
+      })));
+  saturn::MenuItem move;
+  move.label = u"Move to";
+  saturn::Store& store = saturn::Store::Get();
+  std::string space = saturn::GetTabSpace(contents);
+  if (space.empty()) {
+    space = store.SpaceForWindow(browser);
+  }
+  for (const saturn::Space& other : store.spaces()) {
+    if (other.id == space) {
+      continue;
+    }
+    saturn::MenuItem entry;
+    entry.label = other.name;
+    // A tab keeps running only within the same cookies.
+    entry.enabled = SaturnSameCookies(space, other.id);
+    entry.callback = base::BindRepeating(
+        [](tabs::TabHandle handle, std::string to) {
+          if (tabs::TabInterface* tab = handle.Get()) {
+            saturn::SetTabSpace(tab->GetContents(), to);
+          }
+        },
+        tab->GetHandle(), other.id);
+    move.submenu.push_back(std::move(entry));
+  }
+  move.enabled = !move.submenu.empty();
+  items.push_back(std::move(move));
+  items.push_back(saturn::MenuItem::Divider());
+  items.push_back(SaturnMenuRow(
+      &kSaturnTbXIcon, u"Close tab",
+      bind([](BrowserWindowInterface* browser, tabs::TabInterface* tab) {
+        TabStripModel* const model = browser->GetTabStripModel();
+        const int index = model->GetIndexOfTab(tab);
+        if (index != TabStripModel::kNoTab) {
+          model->CloseWebContentsAt(index, TabCloseTypes::CLOSE_USER_GESTURE);
+        }
+      })));
+  saturn::ShowMenu(browser_view->GetWidget(), point, std::move(items));
+}
