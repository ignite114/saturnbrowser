+  const saturn::Folder* Find() const {
+    const saturn::Space* space = saturn::Store::Get().FindSpace(space_id_);
+    if (!space) {
+      return nullptr;
+    }
+    for (const saturn::Folder& folder : space->folders) {
+      if (folder.id == folder_id_) {
+        return &folder;
+      }
+    }
+    return nullptr;
+  }
+
+  void Toggle() {
+    saturn::Store::Get().SetFolderOpen(space_id_, folder_id_, !open_);
+  }
