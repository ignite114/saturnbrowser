+// Saturn menus (saturn_menu.h): shared rows.
+saturn::MenuItem SaturnMenuRow(const gfx::VectorIcon* icon,
+                               std::u16string label,
+                               base::RepeatingClosure callback,
+                               bool enabled = true) {
+  saturn::MenuItem entry;
+  entry.icon = icon;
+  entry.label = std::move(label);
+  entry.callback = std::move(callback);
+  entry.enabled = enabled;
+  return entry;
+}
+
+constexpr SkColor kSaturnDangerColor = SkColorSetRGB(0xFF, 0x3A, 0x3A);
+
+void SaturnCopyUrl(const GURL& url) {
+  ui::ScopedClipboardWriter(ui::ClipboardBuffer::kCopyPaste)
+      .WriteText(base::UTF8ToUTF16(url.spec()));
+}
+
+// Mute / Unmute for a tab (disabled while it plays nothing).
+saturn::MenuItem SaturnMuteRow(content::WebContents* tab,
+                               base::RepeatingClosure callback) {
+  const bool muted = tab && tab->IsAudioMuted();
+  return SaturnMenuRow(
+      muted ? &kSaturnMenuUnmuteTabIcon : &kSaturnMenuMuteTabIcon,
+      muted ? u"Unmute" : u"Mute", std::move(callback),
+      tab && (muted || tab->IsCurrentlyAudible()));
+}
+
+void SaturnToggleMute(content::WebContents* tab) {
+  if (tab) {
+    SetTabAudioMuted(tab, !tab->IsAudioMuted(),
+                     TabMutedReason::kAudioIndicator, std::string());
+  }
+}
+
+// Whether a tab can move to `to` without reloading (same cookies).
+bool SaturnSameCookies(const std::string& from, const std::string& to) {
+  const saturn::Store& store = saturn::Store::Get();
+  const saturn::Space* a = store.FindSpace(from);
+  const saturn::Space* b = store.FindSpace(to);
+  return a && b && a->partition == b->partition && a->profile == b->profile;
+}
