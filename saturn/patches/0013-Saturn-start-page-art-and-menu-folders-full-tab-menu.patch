+    const saturn::Space* s = saturn::Store::Get().FindSpace(space);
+    if (!browser || !s) {
+      return;
+    }
+    std::u16string name;
+    for (const saturn::Folder& f : s->folders) {
+      if (f.id == folder_id) {
+        name = f.name;
+      }
+    }
+    ShowSaturnTextPrompt(
+        BrowserView::GetBrowserViewForBrowser(browser.get()), u"Folder name",
+        name,
+        base::BindOnce(
+            [](std::string space, std::string folder,
+               const std::u16string& name) {
+              saturn::Store::Get().RenameFolder(space, folder, name);
+            },
+            space, folder_id));
+  }
