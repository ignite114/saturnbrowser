+// Saturn: "Sort tabs by": today's tabs of the window's space, in order.
+enum class SaturnSort { kName, kDomain, kRecent };
+void SaturnSortTodayTabs(base::WeakPtr<BrowserWindowInterface> browser,
+                         SaturnSort by) {
+  if (!browser) {
+    return;
+  }
+  TabStripModel* const model = browser->GetTabStripModel();
+  const std::string space = saturn::Store::Get().SpaceForWindow(browser.get());
+  std::vector<content::WebContents*> tabs;
+  for (int i = model->IndexOfFirstNonPinnedTab(); i < model->count(); ++i) {
+    content::WebContents* const contents = model->GetWebContentsAt(i);
+    if (saturn::GetTabSpace(contents) == space &&
+        !saturn::IsItemTab(contents) && !saturn::IsStartPageTab(contents)) {
+      tabs.push_back(contents);
+    }
+  }
+  auto title = [](content::WebContents* c) {
+    std::u16string t = saturn::GetTabCustomTitle(c);
+    return base::i18n::ToLower(t.empty() ? c->GetTitle() : t);
+  };
+  std::ranges::stable_sort(tabs, [&](content::WebContents* x,
+                                     content::WebContents* y) {
+    switch (by) {
+      case SaturnSort::kName:
+        return title(x) < title(y);
+      case SaturnSort::kDomain: {
+        const std::string hx(x->GetLastCommittedURL().host());
+        const std::string hy(y->GetLastCommittedURL().host());
+        return hx != hy ? hx < hy : title(x) < title(y);
+      }
+      case SaturnSort::kRecent:
+        return x->GetLastActiveTimeTicks() > y->GetLastActiveTimeTicks();
+    }
+    return false;
+  });
+  // Moved to the end one by one, in order (other tabs keep theirs).
+  for (content::WebContents* contents : tabs) {
+    const int index = model->GetIndexOfWebContents(contents);
+    if (index != TabStripModel::kNoTab) {
+      model->MoveWebContentsAt(index, model->count() - 1,
+                               /*select_after_move=*/false);
+    }
+  }
+}
