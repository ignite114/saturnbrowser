+void ShowSaturnNewSpacePopup(BrowserView* browser_view,
+                             SaturnNewSpaceCallback callback) {
+  if (!browser_view || !browser_view->GetWidget()) {
+    return;
+  }
+  if (!browser_view->GetProperty(kSaturnNewSpacePopupKey)) {
+    browser_view->SetProperty(
+        kSaturnNewSpacePopupKey,
+        std::make_unique<SaturnNewSpacePopup>(browser_view));
+  }
+  browser_view->GetProperty(kSaturnNewSpacePopupKey)->Show(std::move(callback));
+}
