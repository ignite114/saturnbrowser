+#ifndef CHROME_BROWSER_UI_TABS_SATURN_STORE_H_
+#define CHROME_BROWSER_UI_TABS_SATURN_STORE_H_
+
+#include <map>
+#include <string>
+#include <vector>
+
+#include "base/callback_list.h"
+#include "base/functional/callback_forward.h"
+#include "base/no_destructor.h"
+#include "base/supports_user_data.h"
+#include "url/gurl.h"
+
+class BrowserWindowInterface;
+class Profile;
+
+namespace content {
+class StoragePartitionConfig;
+class WebContents;
+}
+
+namespace saturn {
+
+// Saturn keeps its own state (spaces, favorites, Pinned list) outside
+// Chromium's profile data, in "<user data>/Saturn State.json", so it can be
+// synced with a Saturn account later.
+
+enum class ItemKind { kFavorite, kPinned };
+
+struct Item {
+  std::string id;
+  GURL url;
+  std::u16string title;
+};
+
+struct Space {
+  Space();
+  Space(const Space&);
+  Space& operator=(const Space&);
+  ~Space();
+
+  std::string id;
+  std::u16string name;
+  // Chromium profile directory (base name) the space lives in.
+  std::string profile;
+  // Empty: the space shares the profile's cookies and site data. Otherwise
+  // the name of the space's own (persistent) storage partition: separate
+  // cookies and logins, in the same window.
+  std::string partition;
+  // True once the old pinned tabs / Pinned bookmarks were imported.
+  bool imported = false;
+  std::vector<Item> favorites;
+  std::vector<Item> pinned;
+
+  std::vector<Item>& items(ItemKind kind) {
+    return kind == ItemKind::kFavorite ? favorites : pinned;
+  }
+  const std::vector<Item>& items(ItemKind kind) const {
+    return kind == ItemKind::kFavorite ? favorites : pinned;
+  }
+};
+
+class Store {
+ public:
+  static Store& Get();
+
+  Store(const Store&) = delete;
+  Store& operator=(const Store&) = delete;
+
+  // The file is read asynchronously at startup; until then everything is
+  // empty and changes are ignored. Observers run once it is loaded.
+  bool loaded() const { return loaded_; }
+
+  const std::vector<Space>& spaces() const { return spaces_; }
+  const Space* FindSpace(const std::string& id) const;
+
+  // The space shown in `browser`'s window. Picks (or creates) the first space
+  // using the window's profile. Empty until loaded.
+  std::string SpaceForWindow(BrowserWindowInterface* browser);
+  void SetSpaceForWindow(BrowserWindowInterface* browser,
+                         const std::string& space_id);
+
+  // Adds a space and returns its id. `own_cookies` gives it its own storage
+  // partition.
+  std::string AddSpace(const std::u16string& name,
+                       const std::string& profile,
+                       bool own_cookies = false);
+  void RemoveSpace(const std::string& space_id);
+  void SetImported(const std::string& space_id);
+
+  // Returns the id of the new (or already present, same URL) item, or "".
+  std::string AddItem(const std::string& space_id,
+                      ItemKind kind,
+                      const GURL& url,
+                      const std::u16string& title);
+  void RemoveItem(const std::string& space_id,
+                  ItemKind kind,
+                  const std::string& item_id);
+  const Item* FindItem(const std::string& space_id,
+                       ItemKind kind,
+                       const std::string& item_id) const;
+
+  // Runs after every change (and once after loading).
+  base::CallbackListSubscription AddObserver(base::RepeatingClosure callback);
+
+  // Tells observers that tabs were (un)assigned to items.
+  void NotifyTabsChanged() { observers_.Notify(); }
+
+ private:
+  friend class base::NoDestructor<Store>;
+  Store();
+  ~Store();
+
+  Space* MutableSpace(const std::string& id);
+  void OnLoaded(std::string json);
+  void Changed();
+  void Save();
+
+  bool loaded_ = false;
+  std::vector<Space> spaces_;
+  // The space shown last (new windows open on it).
+  std::string current_space_;
+  // Window (session id) -> space id.
+  std::map<int, std::string> window_spaces_;
+  base::RepeatingClosureList observers_;
+};
+
+// A tab opened from a favorite or a Pinned list row belongs to that item: it
+// is not listed with today's tabs, the item shows it instead.
+struct TabTag : public base::SupportsUserData::Data {
+  std::string space_id;
+  ItemKind kind = ItemKind::kFavorite;
+  std::string item_id;
+};
+
+const TabTag* GetTabTag(const content::WebContents* contents);
+void SetTabTag(content::WebContents* contents,
+               const std::string& space_id,
+               ItemKind kind,
+               const std::string& item_id);
+void ClearTabTag(content::WebContents* contents);
+
+// Whether the tab is hidden from today's list.
+bool IsItemTab(const content::WebContents* contents);
+
+// The space a tab belongs to ("" if not assigned yet).
+std::string GetTabSpace(const content::WebContents* contents);
+void SetTabSpace(content::WebContents* contents, const std::string& space_id);
+
+// The storage partition of a space with its own cookies.
+content::StoragePartitionConfig PartitionConfig(Profile* profile,
+                                                const std::string& partition);
+
+// Session restore: tab extra data keys, and re-applying them.
+inline constexpr char kSessionSpaceKey[] = "saturn_space";
+inline constexpr char kSessionPartitionKey[] = "saturn_partition";
+inline constexpr char kSessionItemKey[] = "saturn_item";
+void RestoreTabTags(content::WebContents* contents,
+                    const std::map<std::string, std::string>& extra_data);
+// Writes the tab's space / item into the session (also called when the
+// session file is rebuilt).
+void PersistTabTags(content::WebContents* contents);
+std::map<std::string, std::string> TabTagsForSession(
+    const content::WebContents* contents);
+
+// Finds the open tab of an item in `browser`'s window, if any.
+content::WebContents* FindItemTab(BrowserWindowInterface* browser,
+                                  const std::string& item_id);
+
+// Activates the item's tab, opening it first if needed.
+void OpenItem(BrowserWindowInterface* browser,
+              const std::string& space_id,
+              ItemKind kind,
+              const std::string& item_id);
+
+}  // namespace saturn
+
+#endif  // CHROME_BROWSER_UI_TABS_SATURN_STORE_H_
