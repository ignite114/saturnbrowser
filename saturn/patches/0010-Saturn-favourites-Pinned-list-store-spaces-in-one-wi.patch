+
+SaturnTodayHeader* SaturnHeaderFor(views::View* view) {
+  for (views::View* v = view; v; v = v->parent()) {
+    if (views::IsViewClass<VerticalTabStripRegionView>(v)) {
+      std::vector<views::View*> stack = {v};
+      while (!stack.empty()) {
+        views::View* const cur = stack.back();
+        stack.pop_back();
+        if (auto* header = views::AsViewClass<SaturnTodayHeader>(cur)) {
+          return header;
+        }
+        for (views::View* child : cur->children()) {
+          stack.push_back(child);
+        }
+      }
+      return nullptr;
+    }
+  }
+  return nullptr;
+}
+
+void SaturnSwitchToSpace(views::View* from, const std::string& space_id) {
+  if (SaturnTodayHeader* header = SaturnHeaderFor(from)) {
+    header->SwitchTo(space_id);
+  }
+}
+
+void SaturnCreateSpace(views::View* from,
+                       const std::u16string& name,
+                       bool own_cookies) {
+  SaturnTodayHeader* const header = SaturnHeaderFor(from);
+  saturn::Store& store = saturn::Store::Get();
+  const saturn::Space* current = store.FindSpace(header ? header->space_id()
+                                                        : std::string());
+  if (!header || !current) {
+    return;
+  }
+  const std::string id = store.AddSpace(
+      name.empty() ? u"Space " + base::NumberToString16(store.spaces().size() +
+                                                        1)
+                   : name,
+      current->profile, own_cookies);
+  store.SetImported(id);
+  header->SwitchTo(id);
+}
+
+void SaturnDeleteSpace(base::WeakPtr<BrowserWindowInterface> browser,
+                       std::string space_id) {
+  saturn::Store& store = saturn::Store::Get();
+  if (!browser || store.spaces().size() < 2 || !store.FindSpace(space_id)) {
+    return;
+  }
+  BrowserView* const view = BrowserView::GetBrowserViewForBrowser(browser.get());
+  if (store.SpaceForWindow(browser.get()) == space_id && view) {
+    for (const saturn::Space& space : store.spaces()) {
+      if (space.id != space_id) {
+        SaturnSwitchToSpace(view->vertical_tab_strip_region_view_for_testing(),
+                            space.id);
+        break;
+      }
+    }
+  }
+  TabStripModel* const model = browser->GetTabStripModel();
+  for (int i = model->count() - 1; i >= 0; --i) {
+    if (saturn::GetTabSpace(model->GetWebContentsAt(i)) == space_id) {
+      model->CloseWebContentsAt(i, TabCloseTypes::CLOSE_USER_GESTURE);
+    }
+  }
+  store.RemoveSpace(space_id);
+}
