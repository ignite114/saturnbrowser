+  }
+
+  raw_ptr<BrowserView> browser_view_;
+  std::unique_ptr<views::Widget> widget_;
+  raw_ptr<views::Textfield> name_ = nullptr;
+  raw_ptr<views::RadioButton> shared_ = nullptr;
