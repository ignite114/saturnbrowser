+    layout->set_cross_axis_alignment(
+        views::BoxLayout::CrossAxisAlignment::kStretch);
+
+    auto* title = contents->AddChildView(
+        std::make_unique<views::Label>(u"New space"));
+    title->SetFontList(saturn::SidebarFont().DeriveWithSizeDelta(2));
+    title->SetAutoColorReadabilityEnabled(false);
+    title->SetEnabledColor(SK_ColorWHITE);
+    title->SetHorizontalAlignment(gfx::ALIGN_LEFT);
+
+    name_ = contents->AddChildView(std::make_unique<views::Textfield>());
+    name_->set_controller(this);
+    name_->SetBackgroundColor(SkColorSetARGB(0x0D, 0xFF, 0xFF, 0xFF));
+    name_->SetTextColorId(ui::kColorSysOnSurface);
+    name_->SetPlaceholderText(u"Space name");
+    name_->SetPlaceholderTextColorId(ui::kColorSysOnSurfaceSubtle);
+    name_->SetFontList(saturn::SidebarFont());
+    name_->GetViewAccessibility().SetName(u"Space name");
+
+    constexpr int kGroup = 1;
+    shared_ = contents->AddChildView(std::make_unique<views::RadioButton>(
+        u"Share logins and cookies with this space", kGroup));
+    own_ = contents->AddChildView(std::make_unique<views::RadioButton>(
+        u"Separate logins (own cookies)", kGroup));
+    for (views::RadioButton* radio : {shared_.get(), own_.get()}) {
+      radio->SetEnabledTextColors(SK_ColorWHITE);
+      radio->SetCheckedIconImageColor(SK_ColorWHITE);
+    }
+
+    auto* create = contents->AddChildView(std::make_unique<views::LabelButton>(
+        base::BindRepeating(&SaturnNewSpacePopup::Submit,
+                            base::Unretained(this)),
+        u"Create"));
+    create->SetEnabledTextColors(SK_ColorWHITE);
+    create->SetHorizontalAlignment(gfx::ALIGN_CENTER);
+    create->SetBackground(views::CreateRoundedRectBackground(
+        SkColorSetARGB(0x1A, 0xFF, 0xFF, 0xFF), 8));
+    create->SetMinSize(gfx::Size(0, 32));
+
+    widget_->SetContentsView(std::move(contents));
+    observation_.Observe(widget_.get());
+  }
+
+  void Submit() {
+    std::u16string name;
+    base::TrimWhitespace(name_->GetText(), base::TRIM_ALL, &name);
+    const bool own_cookies = own_->GetChecked();
+    SaturnNewSpaceCallback callback = std::move(callback_);
+    Hide();
+    if (callback) {
+      std::move(callback).Run(name, own_cookies);
