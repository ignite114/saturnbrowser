+namespace saturn {
+
+namespace {
+
+constexpr char kTabTagKey[] = "saturn_tab_tag";
+constexpr char kSpaceTagKey[] = "saturn_space_tag";
+
+struct SpaceTag : public base::SupportsUserData::Data {
+  std::string space_id;
+};
+
+base::FilePath StateFilePath() {
+  base::FilePath dir;
+  if (!base::PathService::Get(chrome::DIR_USER_DATA, &dir)) {
+    return base::FilePath();
+  }
+  return dir.Append(FILE_PATH_LITERAL("Saturn State.json"));
+}
+
+std::string NewId() {
+  return base::Uuid::GenerateRandomV4().AsLowercaseString();
+}
+
+std::string ProfileName(BrowserWindowInterface* browser) {
+  return browser->GetProfile()
+      ->GetOriginalProfile()
+      ->GetPath()
+      .BaseName()
+      .AsUTF8Unsafe();
+}
+
+base::ListValue ItemsToList(const std::vector<Item>& items) {
+  base::ListValue list;
+  for (const Item& item : items) {
+    list.Append(base::DictValue()
+                    .Set("id", item.id)
+                    .Set("url", item.url.spec())
+                    .Set("title", item.title));
+  }
+  return list;
+}
+
+std::vector<Item> ListToItems(const base::ListValue* list) {
+  std::vector<Item> items;
+  if (!list) {
+    return items;
+  }
+  for (const base::Value& value : *list) {
+    const base::DictValue* dict = value.GetIfDict();
+    if (!dict) {
+      continue;
+    }
+    Item item;
+    if (const std::string* id = dict->FindString("id")) {
+      item.id = *id;
+    }
+    if (const std::string* url = dict->FindString("url")) {
+      item.url = GURL(*url);
+    }
+    if (const std::string* title = dict->FindString("title")) {
+      item.title = base::UTF8ToUTF16(*title);
+    }
+    if (!item.id.empty() && item.url.is_valid()) {
+      items.push_back(std::move(item));
+    }
+  }
+  return items;
+}
+
+}  // namespace
+
+Space::Space() = default;
+Space::Space(const Space&) = default;
+Space& Space::operator=(const Space&) = default;
+Space::~Space() = default;
+
+// static
+Store& Store::Get() {
+  static base::NoDestructor<Store> store;
+  return *store;
+}
+
+Store::Store() {
+  const base::FilePath path = StateFilePath();
+  if (path.empty()) {
+    OnLoaded(std::string());
+    return;
+  }
+  base::ThreadPool::PostTaskAndReplyWithResult(
+      FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_BLOCKING},
+      base::BindOnce(
+          [](base::FilePath path) {
+            std::string json;
+            base::ReadFileToString(path, &json);
+            return json;
+          },
+          path),
+      base::BindOnce(&Store::OnLoaded, base::Unretained(this)));
+}
+
+Store::~Store() = default;
+
+void Store::OnLoaded(std::string json) {
+  std::optional<base::Value> root = base::JSONReader::Read(json, base::JSON_PARSE_RFC);
+  if (root && root->is_dict()) {
+    if (const base::ListValue* spaces = root->GetDict().FindList("spaces")) {
+      for (const base::Value& value : *spaces) {
+        const base::DictValue* dict = value.GetIfDict();
+        if (!dict) {
+          continue;
+        }
+        Space space;
+        if (const std::string* id = dict->FindString("id")) {
+          space.id = *id;
+        }
+        if (const std::string* name = dict->FindString("name")) {
+          space.name = base::UTF8ToUTF16(*name);
+        }
+        if (const std::string* profile = dict->FindString("profile")) {
+          space.profile = *profile;
+        }
+        if (const std::string* partition = dict->FindString("partition")) {
+          space.partition = *partition;
+        }
+        space.imported = dict->FindBool("imported").value_or(false);
+        space.favorites = ListToItems(dict->FindList("favorites"));
+        space.pinned = ListToItems(dict->FindList("pinned"));
+        if (!space.id.empty()) {
+          spaces_.push_back(std::move(space));
+        }
+      }
+    }
+  }
+  if (root && root->is_dict()) {
+    if (const std::string* current = root->GetDict().FindString("current")) {
+      current_space_ = *current;
+    }
+  }
+  loaded_ = true;
+  observers_.Notify();
+}
+
+const Space* Store::FindSpace(const std::string& id) const {
+  auto it = std::ranges::find(spaces_, id, &Space::id);
+  return it == spaces_.end() ? nullptr : &*it;
+}
+
+Space* Store::MutableSpace(const std::string& id) {
+  auto it = std::ranges::find(spaces_, id, &Space::id);
+  return it == spaces_.end() ? nullptr : &*it;
+}
+
+std::string Store::SpaceForWindow(BrowserWindowInterface* browser) {
+  if (!loaded_ || !browser) {
+    return std::string();
+  }
+  const int window = browser->GetSessionID().id();
+  if (auto it = window_spaces_.find(window);
+      it != window_spaces_.end() && FindSpace(it->second)) {
+    return it->second;
+  }
+  const std::string profile = ProfileName(browser);
+  std::string id;
+  if (const Space* current = FindSpace(current_space_);
+      current && current->profile == profile) {
+    id = current->id;
+  }
+  for (const Space& space : spaces_) {
+    if (!id.empty()) {
+      break;
+    }
+    if (space.profile == profile) {
+      id = space.id;
+      break;
+    }
+  }
+  if (id.empty()) {
+    id = AddSpace(spaces_.empty() ? u"Primary" : u"Space", profile);
+  }
+  window_spaces_[window] = id;
+  return id;
+}
+
+void Store::SetSpaceForWindow(BrowserWindowInterface* browser,
+                              const std::string& space_id) {
+  if (!browser || !FindSpace(space_id)) {
+    return;
+  }
+  window_spaces_[browser->GetSessionID().id()] = space_id;
+  if (current_space_ != space_id) {
+    current_space_ = space_id;
+    Save();
+  }
+  observers_.Notify();
+}
+
+std::string Store::AddSpace(const std::u16string& name,
+                            const std::string& profile,
+                            bool own_cookies) {
+  Space space;
+  space.id = NewId();
+  space.name = name;
+  space.profile = profile;
+  if (own_cookies) {
+    // [a-z0-9] only: used as a storage partition name.
+    for (char c : space.id) {
+      if (c != '-') {
+        space.partition += c;
+      }
+    }
+  }
+  spaces_.push_back(space);
+  Changed();
+  return space.id;
+}
+
+void Store::RemoveSpace(const std::string& space_id) {
+  if (spaces_.size() <= 1) {
+    return;
+  }
+  std::erase_if(spaces_,
+                [&](const Space& space) { return space.id == space_id; });
+  std::erase_if(window_spaces_,
+                [&](const auto& entry) { return entry.second == space_id; });
+  if (current_space_ == space_id) {
+    current_space_ = spaces_.front().id;
+  }
+  Changed();
+}
+
+void Store::SetImported(const std::string& space_id) {
+  if (Space* space = MutableSpace(space_id); space && !space->imported) {
+    space->imported = true;
+    Changed();
+  }
+}
+
+std::string Store::AddItem(const std::string& space_id,
+                           ItemKind kind,
+                           const GURL& url,
+                           const std::u16string& title) {
+  Space* space = MutableSpace(space_id);
+  if (!loaded_ || !space || !url.is_valid()) {
+    return std::string();
+  }
+  std::vector<Item>& items = space->items(kind);
+  if (auto it = std::ranges::find(items, url, &Item::url); it != items.end()) {
+    return it->id;
+  }
+  Item item;
+  item.id = NewId();
+  item.url = url;
+  item.title = title.empty() ? base::UTF8ToUTF16(url.host()) : title;
+  items.push_back(item);
+  Changed();
+  return item.id;
+}
+
+void Store::RemoveItem(const std::string& space_id,
+                       ItemKind kind,
+                       const std::string& item_id) {
+  Space* space = MutableSpace(space_id);
+  if (!space) {
+    return;
+  }
+  std::vector<Item>& items = space->items(kind);
+  const size_t erased = std::erase_if(
+      items, [&](const Item& item) { return item.id == item_id; });
+  if (erased) {
+    Changed();
+  }
+}
+
+const Item* Store::FindItem(const std::string& space_id,
+                            ItemKind kind,
+                            const std::string& item_id) const {
+  const Space* space = FindSpace(space_id);
+  if (!space) {
+    return nullptr;
+  }
+  const std::vector<Item>& items = space->items(kind);
+  auto it = std::ranges::find(items, item_id, &Item::id);
+  return it == items.end() ? nullptr : &*it;
+}
+
+base::CallbackListSubscription Store::AddObserver(
+    base::RepeatingClosure callback) {
+  return observers_.Add(std::move(callback));
+}
+
+void Store::Changed() {
+  Save();
+  observers_.Notify();
+}
+
+void Store::Save() {
+  if (!loaded_) {
+    return;
+  }
+  const base::FilePath path = StateFilePath();
+  if (path.empty()) {
+    return;
+  }
+  base::ListValue spaces;
+  for (const Space& space : spaces_) {
+    spaces.Append(base::DictValue()
+                      .Set("id", space.id)
+                      .Set("name", space.name)
+                      .Set("profile", space.profile)
+                      .Set("partition", space.partition)
+                      .Set("imported", space.imported)
+                      .Set("favorites", ItemsToList(space.favorites))
+                      .Set("pinned", ItemsToList(space.pinned)));
+  }
+  base::DictValue root;
+  root.Set("version", 1);
+  root.Set("current", current_space_);
+  root.Set("spaces", std::move(spaces));
+  std::optional<std::string> json = base::WriteJsonWithOptions(
+      root, base::JSONWriter::OPTIONS_PRETTY_PRINT);
+  if (!json) {
+    return;
+  }
+  base::ThreadPool::PostTask(
+      FROM_HERE,
+      {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+       base::TaskShutdownBehavior::BLOCK_SHUTDOWN},
+      base::BindOnce(
+          [](base::FilePath path, std::string json) {
+            base::ImportantFileWriter::WriteFileAtomically(path, json);
+          },
+          path, std::move(*json)));
+}
+
+const TabTag* GetTabTag(const content::WebContents* contents) {
+  return contents ? static_cast<const TabTag*>(
+                        contents->GetUserData(kTabTagKey))
+                  : nullptr;
+}
+
+void SetTabTag(content::WebContents* contents,
+               const std::string& space_id,
+               ItemKind kind,
+               const std::string& item_id) {
+  if (!contents) {
+    return;
+  }
+  auto tag = std::make_unique<TabTag>();
+  tag->space_id = space_id;
+  tag->kind = kind;
+  tag->item_id = item_id;
+  contents->SetUserData(kTabTagKey, std::move(tag));
+  if (GetTabSpace(contents) != space_id) {
+    auto space = std::make_unique<SpaceTag>();
+    space->space_id = space_id;
+    contents->SetUserData(kSpaceTagKey, std::move(space));
+  }
+  PersistTabTags(contents);
+  Store::Get().NotifyTabsChanged();
+}
+
+void ClearTabTag(content::WebContents* contents) {
+  if (contents) {
+    contents->RemoveUserData(kTabTagKey);
+    PersistTabTags(contents);
+    Store::Get().NotifyTabsChanged();
+  }
+}
+
+std::string GetTabSpace(const content::WebContents* contents) {
+  const auto* tag = contents ? static_cast<const SpaceTag*>(
+                                   contents->GetUserData(kSpaceTagKey))
+                             : nullptr;
+  return tag ? tag->space_id : std::string();
+}
+
+void SetTabSpace(content::WebContents* contents, const std::string& space_id) {
+  if (!contents || GetTabSpace(contents) == space_id) {
+    return;
+  }
+  auto tag = std::make_unique<SpaceTag>();
+  tag->space_id = space_id;
+  contents->SetUserData(kSpaceTagKey, std::move(tag));
+  PersistTabTags(contents);
+  Store::Get().NotifyTabsChanged();
+}
+
+content::StoragePartitionConfig PartitionConfig(Profile* profile,
+                                                const std::string& partition) {
+  return content::StoragePartitionConfig::Create(
+      profile, "saturnspace", partition, /*in_memory=*/false);
+}
+
+std::map<std::string, std::string> TabTagsForSession(
+    const content::WebContents* contents) {
+  std::map<std::string, std::string> data;
+  const std::string space_id = GetTabSpace(contents);
+  data[kSessionSpaceKey] = space_id;
+  const Space* space = Store::Get().FindSpace(space_id);
+  data[kSessionPartitionKey] = space ? space->partition : std::string();
+  const TabTag* tag = GetTabTag(contents);
+  data[kSessionItemKey] =
+      tag ? (tag->kind == ItemKind::kFavorite ? "f:" : "p:") + tag->item_id
+          : std::string();
+  return data;
+}
+
+void PersistTabTags(content::WebContents* contents) {
+  if (!contents) {
+    return;
+  }
+  SessionService* const service = SessionServiceFactory::GetForProfile(
+      Profile::FromBrowserContext(contents->GetBrowserContext()));
+  const SessionID window_id =
+      sessions::SessionTabHelper::IdForWindowContainingTab(contents);
+  const SessionID tab_id = sessions::SessionTabHelper::IdForTab(contents);
+  if (!service || !window_id.is_valid() || !tab_id.is_valid()) {
+    return;
+  }
+  for (const auto& [key, value] : TabTagsForSession(contents)) {
+    service->AddTabExtraData(window_id, tab_id, key.c_str(), value);
+  }
+}
+
+void RestoreTabTags(content::WebContents* contents,
+                    const std::map<std::string, std::string>& extra_data) {
+  auto get = [&](const char* key) {
+    auto it = extra_data.find(key);
+    return it == extra_data.end() ? std::string() : it->second;
+  };
+  const std::string space_id = get(kSessionSpaceKey);
+  if (space_id.empty()) {
+    return;
+  }
+  auto space = std::make_unique<SpaceTag>();
+  space->space_id = space_id;
+  contents->SetUserData(kSpaceTagKey, std::move(space));
+  const std::string item = get(kSessionItemKey);
+  if (item.size() > 2 && item[1] == ':') {
+    auto tag = std::make_unique<TabTag>();
+    tag->space_id = space_id;
+    tag->kind = item[0] == 'f' ? ItemKind::kFavorite : ItemKind::kPinned;
+    tag->item_id = item.substr(2);
+    contents->SetUserData(kTabTagKey, std::move(tag));
+  }
+}
+
+bool IsItemTab(const content::WebContents* contents) {
+  return GetTabTag(contents) != nullptr;
+}
+
+content::WebContents* FindItemTab(BrowserWindowInterface* browser,
+                                  const std::string& item_id) {
+  if (!browser || item_id.empty()) {
+    return nullptr;
+  }
+  TabStripModel* const model = browser->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    content::WebContents* const contents = model->GetWebContentsAt(i);
+    if (const TabTag* tag = GetTabTag(contents);
+        tag && tag->item_id == item_id) {
+      return contents;
+    }
+  }
+  return nullptr;
+}
+
+void OpenItem(BrowserWindowInterface* browser,
+              const std::string& space_id,
+              ItemKind kind,
+              const std::string& item_id) {
+  TabStripModel* const model = browser->GetTabStripModel();
+  if (content::WebContents* contents = FindItemTab(browser, item_id)) {
+    model->ActivateTabAt(model->GetIndexOfWebContents(contents));
+    return;
+  }
+  const Item* item = Store::Get().FindItem(space_id, kind, item_id);
+  if (!item) {
+    return;
+  }
+  const GURL url = item->url;
+  content::WebContents* contents =
+      chrome::AddAndReturnTabAt(browser, url, -1, /*foreground=*/true);
+  SetTabTag(contents, space_id, kind, item_id);
+}
+
+}  // namespace saturn
