+bool ToolbarView::IsSaturnSidebarLayout() const {
+  return browser_view_ && should_display_vertical_tabs_ &&
+         location_bar_view_ && browser_view_->ShouldDrawVerticalTabStrip() &&
+         !browser_view_->IsVerticalTabStripCollapsed() &&
+         !browser_view_->IsFullscreen();
+}
+
+void ToolbarView::LayoutSaturnSidebar() {
+  constexpr int kSize = saturn::kSidebarButtonSize;
+  constexpr int kStep = kSize + saturn::kSidebarButtonSpacing;
+
+  // Everything not placed below gets no space in the sidebar; the app menu
+  // (behind the sliders icon) covers extensions, profile, bookmarks, etc.
+  // Park them far off-screen: some have their own layers, which a zero-size
+  // rect at the origin would not hide.
+  for (views::View* child : children()) {
+    child->SetBoundsRect(gfx::Rect(-10000, -10000, 0, 0));
+  }
+
+  // Row 1, leading: back, forward, reload.
+  int x = 0;
+  for (views::View* button :
+       std::array<views::View*, 3>{back_, forward_, reload_}) {
+    if (!button) {
+      continue;
+    }
+    button->SetVisible(true);
+    button->SetBoundsRect(gfx::Rect(x, 0, kSize, kSize));
+    x += kStep;
+  }
+
+  // Row 1, trailing: [sidebar toggle] [menu].
+  int trailing = width();
+  for (views::View* button : std::array<views::View*, 2>{
+           app_menu_button_, saturn_sidebar_toggle_}) {
+    if (!button) {
+      continue;
+    }
+    button->SetVisible(true);
+    trailing -= kSize;
+    button->SetBoundsRect(gfx::Rect(trailing, 0, kSize, kSize));
+    trailing -= saturn::kSidebarButtonSpacing;
+  }
+
+  // Row 2: the URL pill.
+  location_bar_view_->SetVisible(true);
+  location_bar_view_->SetBoundsRect(
+      gfx::Rect(0, kSize + saturn::kSidebarRowGap, width(),
+                saturn::kSidebarUrlPillHeight));
+}
+
+void ToolbarView::OnSaturnSidebarCollapseChanged(
+    tabs::VerticalTabStripCollapseState) {
+  InvalidateLayout();
+  PreferredSizeChanged();
+}
