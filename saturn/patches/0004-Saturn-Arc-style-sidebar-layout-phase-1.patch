@@ -88,6 +93,20 @@ void AddChromeColorMixers(ui::ColorProvider* provider,
   // Must be the last one in order to override other mixer colors.
   AddNativeChromeColorMixer(provider, key);
 
+  // Saturn: in dark mode the frame (sidebar + margins around the page card)
+  // uses the sidebar color from the design. Custom themes still win.
+  if (key.color_mode == ui::ColorProviderKey::ColorMode::kDark &&
+      !key.custom_theme) {
+    ui::ColorMixer& mixer = provider->AddMixer();
+    mixer[ui::kColorFrameActive] = {SkColorSetRGB(0x45, 0x45, 0x45)};
+    mixer[ui::kColorFrameInactive] = {SkColorSetRGB(0x45, 0x45, 0x45)};
+    // URL pill: white 5% (hover 8%) over the sidebar, as solid colors so the
+    // text field and its child views blend in.
+    mixer[kColorLocationBarBackground] = {SkColorSetRGB(0x4E, 0x4E, 0x4E)};
+    mixer[kColorLocationBarBackgroundHovered] = {
+        SkColorSetRGB(0x54, 0x54, 0x54)};
+  }
+
   if (key.custom_theme) {
     key.custom_theme->AddColorMixers(provider, key);
   }
