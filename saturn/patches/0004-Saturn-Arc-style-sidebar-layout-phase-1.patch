@@ -0,0 +1,41 @@
+// Copyright 2026 The Saturn Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_FRAME_SATURN_SIDEBAR_CONSTANTS_H_
+#define CHROME_BROWSER_UI_VIEWS_FRAME_SATURN_SIDEBAR_CONSTANTS_H_
+
+#include "third_party/skia/include/core/SkColor.h"
+
+// Saturn's Arc-style sidebar (Figma "Custom OS", node 4097:334).
+//
+// When vertical tabs are shown, Saturn uses a thin native title bar, and while
+// the vertical tab strip is expanded the toolbar moves into the sidebar as two
+// rows: [back forward reload ... sidebar-toggle menu] over the URL pill. The
+// page is drawn as an inset card next to the sidebar.
+namespace saturn {
+
+// Sidebar inner padding (left/right/top) and the gap around the page card.
+inline constexpr int kSidebarPadding = 10;
+inline constexpr int kContentMargin = 10;
+inline constexpr int kContentCornerRadius = 5;
+
+// Toolbar inside the sidebar.
+inline constexpr int kSidebarButtonSize = 34;
+inline constexpr int kSidebarButtonSpacing = 5;
+inline constexpr int kSidebarRowGap = 8;
+inline constexpr int kSidebarUrlPillHeight = 38;
+inline constexpr int kSidebarUrlPillRadius = 10;
+inline constexpr int kSidebarToolbarBottomGap = 8;
+inline constexpr int kSidebarToolbarHeight =
+    kSidebarButtonSize + kSidebarRowGap + kSidebarUrlPillHeight;
+
+// Colors (dark design).
+inline constexpr SkColor kSidebarColor = SkColorSetRGB(0x45, 0x45, 0x45);
+inline constexpr SkColor kTitlebarColor = SkColorSetRGB(0x16, 0x16, 0x16);
+// White at 5% over the sidebar, for the URL pill.
+inline constexpr SkColor kUrlPillColor = SkColorSetARGB(0x0D, 0xFF, 0xFF, 0xFF);
+
+}  // namespace saturn
+
+#endif  // CHROME_BROWSER_UI_VIEWS_FRAME_SATURN_SIDEBAR_CONSTANTS_H_
