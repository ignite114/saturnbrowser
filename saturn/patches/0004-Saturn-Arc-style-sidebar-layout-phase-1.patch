 void BrowserViewTabbedLayoutImpl::DoPostLayoutVisualAdjustments(
     const BrowserLayoutParams& params) {
+  // Saturn: in the sidebar layout the browser view itself shows the sidebar
+  // color behind the toolbar and around the page card. Other layouts leave it
+  // transparent so the frame (and theme images) show through.
+  views::View* const browser_view = views().browser_view;
+  if (layout_data_->saturn_sidebar && !browser_view->background()) {
+    browser_view->SetBackground(
+        views::CreateSolidBackground(ui::kColorFrameActive));
+  } else if (!layout_data_->saturn_sidebar && browser_view->background()) {
+    browser_view->SetBackground(nullptr);
+  }
+
   // If the window goes out of glass mode, these changes won't hurt anything.
   if (in_glass_mode()) {
     gfx::RoundedCornersF content_corners;
@@ -1595,6 +1654,16 @@ void BrowserViewTabbedLayoutImpl::DoPostLayoutVisualAdjustments(
     views().multi_contents_view->SetBackgroundRadii(content_corners);
   }
 
+  // Saturn: the page is a card with rounded corners inside the sidebar color.
+  const gfx::RoundedCornersF saturn_corners(saturn::kContentCornerRadius);
+  if (layout_data_->saturn_sidebar) {
+    views().multi_contents_view->SetBackgroundRadii(saturn_corners);
+  } else if (!in_glass_mode() &&
+             views().multi_contents_view->GetBackgroundRadii() ==
+                 saturn_corners) {
+    views().multi_contents_view->SetBackgroundRadii(gfx::RoundedCornersF());
+  }
+
   // Want to cut the vertical tabstrip and its decorations out of the top
   // container in transparency mode.
   CustomCornersBackground::Cutouts top_container_cutout_views;
